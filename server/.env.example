# Proxmox connection
# Hostname or IP of your Proxmox server
PROXMOX_HOST=192.168.1.100

# API token in the form user@realm!tokenname
PROXMOX_TOKEN_ID=root@pam!devbox

# The secret part of the API token (shown once at creation time)
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Proxmox node name (shown in the Proxmox UI sidebar, usually "pve")
PROXMOX_NODE=pve

# VMID of the template VM to clone devboxes from
PROXMOX_TEMPLATE_VMID=200

# New devbox VMIDs are allocated starting from this number
PROXMOX_VMID_RANGE_START=300

# Devbox API
# Bearer token clients must send — generate with: openssl rand -hex 32
API_TOKEN=your-secret-token-here

# Domain used to build devbox URLs: http://<name>.<DEVBOX_DOMAIN>
# Must match the wildcard public hostname configured in your Cloudflare Tunnel
DEVBOX_DOMAIN=devbox.example.com

# Cloudflare Tunnel
# Token from: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Configure → Token
TUNNEL_TOKEN=eyJhIjoixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
